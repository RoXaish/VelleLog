# API Base URL
# In development (via Vite proxy): defaults to '/api'
# In production (same-domain or reverse-proxied): leave as '/api'
# In cross-domain production: set to the full URL (e.g. 'https://api.yourdomain.com/api')
VITE_API_BASE_URL="/api"
