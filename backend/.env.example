# ==============================================================================
# Velle Log - Environment Configuration
# ==============================================================================

# Project Metadata
PROJECT_NAME="Velle Log"
ENV="development"

# Database Configuration
# Default: Local SQLite database
# When deploying or switching to PostgreSQL later, use:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/vellelog"
DATABASE_URL="sqlite:///./vellelog.db"

# JWT Authentication
# Required. Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="replace-with-a-long-random-secret-at-least-32-characters"
# Access token lifetime in minutes (must be greater than zero)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
